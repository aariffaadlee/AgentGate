      "requested_tool_action": {"tool_name": "email.send", "arguments": {"recipient": "student@example.test", "subject": "Replay", "body": "Synthetic replay attempt"}},
      "capabilities": ["email.send"],
      "controls": {"trusted_intent_present": true, "approval_status": "consumed", "approval_consumed": true},
      "expected_security_decision": "deny",
      "expected_reason_code": "APPROVAL_REPLAYED",
      "approval_relevant": true
    },
