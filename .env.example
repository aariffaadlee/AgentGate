# All values are fake local-development examples. Copy this file to .env.
POSTGRES_USER=agentgate
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=agentgate

AGENTGATE_ENVIRONMENT=development
AGENTGATE_DATABASE_URL=postgresql+asyncpg://agentgate:change-me-local-only@postgres:5432/agentgate
AGENTGATE_DATABASE_POOL_SIZE=5
AGENTGATE_DATABASE_MAX_OVERFLOW=5
AGENTGATE_DATABASE_POOL_TIMEOUT_SECONDS=5
AGENTGATE_DATABASE_HEALTH_TIMEOUT_SECONDS=2
AGENTGATE_CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
AGENTGATE_MAX_REQUEST_BODY_BYTES=262144
AGENTGATE_DOCS_ENABLED=true
AGENTGATE_LOG_LEVEL=INFO

# Fake development-only identity values. Generate independent random values with:
# python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).rstrip(b'=').decode())"
AGENTGATE_TOKEN_ISSUER=agentgate.local
AGENTGATE_TOKEN_AUDIENCE=agentgate-tools
AGENTGATE_ADMIN_TOKEN_AUDIENCE=agentgate-admin
AGENTGATE_TOKEN_SIGNING_KEY_ID=agentgate-local-ed25519-v1
AGENTGATE_TOKEN_SIGNING_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
AGENTGATE_DATA_ENCRYPTION_KEY_B64=AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE
AGENTGATE_AUDIT_HMAC_KEY_B64=AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI
AGENTGATE_AUDIT_CHECKPOINT_PATH=/audit-checkpoint/audit-head.json
AGENTGATE_ADMIN_BOOTSTRAP_USERNAME=local-admin
AGENTGATE_ADMIN_BOOTSTRAP_SECRET=agentgate-development-bootstrap-secret-change-me
AGENTGATE_ACCESS_TOKEN_TTL_SECONDS=300
AGENTGATE_ADMIN_TOKEN_TTL_SECONDS=900
AGENTGATE_APPROVAL_TTL_SECONDS=180
AGENTGATE_REQUEST_PROOF_TTL_SECONDS=30
AGENTGATE_REQUEST_PROOF_CLOCK_SKEW_SECONDS=5
AGENTGATE_OPA_TIMEOUT_SECONDS=1
AGENTGATE_OPA_MAX_RESPONSE_BYTES=16384
AGENTGATE_SYNTHETIC_DATA_ROOT=/synthetic_data
